    "docx": "^8.5.0",
    "mammoth": "^1.6.0",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "validator": "^13.11.0",
    "bcryptjs": "^2.4.3",
